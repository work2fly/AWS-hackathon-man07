# AI Therapy Platform - Environment Configuration
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here
AWS_ACCOUNT_ID=468263127918

# Lambda Configuration
LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::468263127918:role/ai-therapy-lambda-execution-role

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=ai-therapy
USERS_TABLE_NAME=ai-therapy-users
SESSIONS_TABLE_NAME=ai-therapy-sessions
REDFLAGS_TABLE_NAME=ai-therapy-redflags
NOTIFICATIONS_TABLE_NAME=ai-therapy-notifications

# Cognito Configuration
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_CLIENT_SECRET=your_client_secret

# API Gateway Configuration
WEBSOCKET_API_ENDPOINT=your_websocket_endpoint
API_GATEWAY_STAGE=dev

# Bedrock Configuration (Breaking Barriers UK 2026 compliant)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# Monitoring Configuration
LOG_LEVEL=INFO
ENABLE_XRAY_TRACING=true

# Development Configuration
ENVIRONMENT=development
DEBUG=true