# AI Therapy Platform - Environment Variables
# 🏆 Breaking Barriers UK 2026 compliant
#
# Copy this file and set your values:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env
#   ./integrate.sh

# AWS Configuration
AWS_REGION=us-west-2

# Cognito Configuration
COGNITO_USER_POOL_ID=us-west-2_ASOPUuOOV
COGNITO_FRONTEND_CLIENT_ID=your-client-id-here

# API Gateway URLs (optional - defaults provided)
API_GATEWAY_URL=https://yqv4v90gj9.execute-api.us-west-2.amazonaws.com/dev
WEBSOCKET_URL=wss://yqv4v90gj9.execute-api.us-west-2.amazonaws.com/dev

# How to get COGNITO_FRONTEND_CLIENT_ID:
# ======================================
# Option 1: AWS Console
#   1. Go to AWS Console > Cognito > User Pools
#   2. Select pool: us-west-2_ASOPUuOOV
#   3. Go to "App integration" tab
#   4. Click "Create app client"
#   5. Settings:
#      - App type: Public client
#      - App client name: ai-therapy-platform-frontend-client
#      - Authentication flows: ALLOW_USER_SRP_AUTH, ALLOW_REFRESH_TOKEN_AUTH
#      - Don't generate a client secret
#      - Token expiration: 1 hour (access), 1 hour (ID), 30 days (refresh)
#   6. Copy the Client ID
#
# Option 2: AWS CLI (if logged in)
#   aws cognito-idp create-user-pool-client \
#     --user-pool-id us-west-2_ASOPUuOOV \
#     --client-name ai-therapy-platform-frontend-client \
#     --no-generate-secret \
#     --explicit-auth-flows ALLOW_USER_SRP_AUTH ALLOW_REFRESH_TOKEN_AUTH \
#     --region us-west-2
#
# Option 3: Use existing client
#   aws cognito-idp list-user-pool-clients \
#     --user-pool-id us-west-2_ASOPUuOOV \
#     --region us-west-2

# Usage:
# ======
# 1. Set environment variables:
#    source .env
#
# 2. Run integration script:
#    ./integrate.sh
#
# 3. The script will use these values instead of trying to create resources
